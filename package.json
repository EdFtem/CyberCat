{
  "name": "cybercat",
  "version": "0.1.0",
  "description": "CyberCat: graphical SSH/SFTP file manager with dual panes, resumable transfers, Monaco editor and built-in terminal",
  "keywords": [
    "ssh",
    "sftp",
    "file-manager",
    "electron",
    "scp",
    "terminal",
    "monaco",
    "xterm",
    "winscp-alternative"
  ],
  "homepage": "https://github.com/EdFtem/CyberCat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EdFtem/CyberCat.git"
  },
  "bugs": {
    "url": "https://github.com/EdFtem/CyberCat/issues"
  },
  "main": "./out/main/index.js",
  "author": "Eduard Ftemov",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node --max-old-space-size=4096 node_modules/electron-vite/bin/electron-vite.js build",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "npm run build && electron-builder --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "test:e2e": "esbuild tests/e2e.ts --bundle --platform=node --format=cjs --outfile=out/test/e2e.cjs --external:electron --external:ssh2 --external:iconv-lite --alias:@shared=./src/shared --log-level=warning && electron out/test/e2e.cjs",
    "test:e2e:s3": "esbuild tests/e2e-s3.ts --bundle --platform=node --format=cjs --outfile=out/test/e2e-s3.cjs --external:electron --external:ssh2 --external:iconv-lite --external:@aws-sdk/* --external:@smithy/* --alias:@shared=./src/shared --log-level=warning && electron out/test/e2e-s3.cjs",
    "test:ui": "node tests/run-ui-smoke.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1141.0",
    "@aws-sdk/credential-providers": "3.1141.0",
    "@aws-sdk/s3-request-presigner": "3.1141.0",
    "electron-updater": "^6.8.9",
    "iconv-lite": "^0.7.3",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^5.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.52.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "zustand": "^5.0.15"
  }
}
